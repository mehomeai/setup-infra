# Example local overrides for setup-infra dev setup. Copy to `.env` (untracked)
# only if you want them; command-line flags take precedence.
#
# NEVER put tunnel connector credentials, admin credentials, pairing invitation
# secrets, device secrets, or session tokens in this file. Those live in
# <data-dir>/secrets (mode 0600, untracked) or on the enrolled phone.

# Home data/config destination (default ~/.local/share/me-home)
ME_HOME_DATA_DIR=
# Dev loopback port (default 7070, matches H1 home-api-v1 local default)
ME_HOME_PORT=
# S7 coordination (all default disabled/empty; command-line flags win):
# Local public home base URL for endpointHint/pairing (https://; loopback
# http:// only with ME_HOME_COORDINATOR_ALLOW_HTTP_LOOPBACK=1, dev only)
ME_HOME_PUBLIC_URL=
# Known backend base URL (recorded non-secret; activate must match when set)
ME_HOME_COORDINATOR_BACKEND_URL=
# Absolute path of the private 0600 credentials file
# (default <data-dir>/secrets/backend-home-token.json)
ME_HOME_COORDINATOR_CREDENTIALS_FILE=
# Explicit dev/test opt-in for http:// loopback URLs (never for production)
ME_HOME_COORDINATOR_ALLOW_HTTP_LOOPBACK=
# H7 notifications opt-in (default off) + public Expo project id (never a
# credential). Provider tokens stay in the operator shell and NEVER go here:
#   export HOME_EXPO_ACCESS_TOKEN='<value>'   # shell only, never stored
HOME_NOTIFICATIONS_ENABLED=
HOME_EXPO_PROJECT_ID=
